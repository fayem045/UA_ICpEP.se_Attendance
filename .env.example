VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_DEFAULT_LIMIT=50
VITE_ADMIN_EMAILS=
VITE_API_BASE_URL=http://localhost:4000
# Comma-separated frontend origins allowed to call the backend (for deployed sites).
CORS_ORIGINS=
# Put JWT_SECRET and the Supabase secret key (sb_secret_...) or legacy service_role JWT in .env.local.
# Do not use the publishable/anon key here, and never expose the secret key to Vite or the browser.
